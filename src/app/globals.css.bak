@import "tailwindcss";

@theme {
  --color-ink: #0a0a0b;
  --color-coal: #101013;
  --color-abyss: #0c0c0e;
  --color-line: rgba(244, 242, 237, 0.1);
  --color-paper: #f4f2ed;
  --color-bone: #ede9e0;
  --color-fog: #a7a5a0;
  --color-dim: #6e6d6a;
  --color-accent: #ff4d00;
  --color-ember: #ff8a3d;
  --color-glow: #ffd9b8;
  --font-display: "Bricolage Grotesque", "Syne", "General Sans", system-ui, sans-serif;
  --font-body: "Instrument Sans", "General Sans", system-ui, sans-serif;
}

:root {
  color-scheme: dark;
  /* NOTE: --font-sans is owned by next/font (Instrument Sans + metric fallback).
     Do NOT redeclare it here — an unlayered :root rule would shadow the
     next/font variable class and break the webfont. */
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--color-ink);
  color: var(--color-paper);
  font-family: var(--font-sans);
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}

::selection {
  background: var(--color-accent);
  color: #0a0a0b;
}

/* Display voice — Bricolage Grotesque. Human case, tight tracking, optical
   sizing follows the size. Personality lives here. */
.font-display {
  font-family: var(--font-display);
  letter-spacing: -0.02em;
  font-optical-sizing: auto;
}
/* Quiet voice — Instrument Sans for metadata, labels, UI. Small, tracked,
   secondary. Never decorative. */
.meta {
  font-family: var(--font-sans);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.wrap {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 1.25rem;
}
@media (min-width: 768px) {
  .wrap { padding-inline: 3rem; }
}

.rule {
  border-top: 1px solid var(--color-line);
}

.eyebrow {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-fog);
}

/* Sovereign eyebrow — ceremonial variant with orange tick. */
.eyebrow-sovereign {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
}
.eyebrow-sovereign::before {
  content: "";
  width: 1.5rem;
  height: 2px;
  background: linear-gradient(90deg, var(--color-accent), var(--color-ember));
  box-shadow: 0 0 12px rgba(255, 77, 0, 0.8);
}

/* Monumental double rule — processional divider. */
.rule-majestic {
  position: relative;
  border-top: 1px solid var(--color-line);
}
.rule-majestic::after {
  content: "";
  position: absolute;
  top: 4px;
  left: 0;
  right: 0;
  border-top: 1px solid rgba(244, 242, 237, 0.05);
}

/* Link underline sweep */
.u-link {
  position: relative;
  text-decoration: none;
}
.u-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  height: 1px;
  width: 100%;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
.u-link:hover::after,
.u-link:focus-visible::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* CTA arrow shift */
.cta-arrow {
  display: inline-block;
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
a:hover .cta-arrow,
button:hover .cta-arrow {
  transform: translate(2px, -2px);
}

/* Primary CTA — eye-catchy hover: sliding accent fill + gloss sweep + lift + glow */
.btn-primary {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--color-paper);
  color: #0a0a0b;
  transition:
    color 0.3s ease,
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s ease,
    border-color 0.3s ease;
}
/* sliding accent fill */
.btn-primary::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: -1;
  background: linear-gradient(135deg, #ff4d00 0%, #ff6a00 55%, #ff3d00 100%);
  transform: translateY(102%);
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
/* gloss sweep */
.btn-primary::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 45%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  transform: translateX(-220%) skewX(-18deg);
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}
.btn-primary:hover,
.btn-primary:focus-visible {
  color: #fff;
  transform: translateY(-3px);
  box-shadow:
    0 18px 48px -12px rgba(255, 77, 0, 0.8),
    0 0 0 1px rgba(255, 77, 0, 0.65),
    0 0 32px -4px rgba(255, 77, 0, 0.55);
}
/* Monumental CTA — larger processional presence, same accent system. */
.btn-majestic {
  padding: 1.15rem 2.25rem;
  letter-spacing: 0.12em;
}
.btn-primary:hover::before,
.btn-primary:focus-visible::before {
  transform: translateY(0);
}
.btn-primary:hover::after,
.btn-primary:focus-visible::after {
  transform: translateX(480%) skewX(-18deg);
}
.btn-primary:active {
  transform: translateY(0) scale(0.98);
  box-shadow: 0 4px 16px -6px rgba(255, 77, 0, 0.6);
}
.btn-primary:hover .cta-arrow,
.btn-primary:focus-visible .cta-arrow {
  transform: translateX(5px) scale(1.2);
}
.btn-primary:disabled {
  transform: none;
  box-shadow: none;
}
.btn-primary:disabled::before,
.btn-primary:disabled::after {
  display: none;
}

/* Outline CTA (nav) — fill + glow on hover */
.btn-outline {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  transition:
    color 0.3s ease,
    border-color 0.3s ease,
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s ease,
    background-color 0.3s ease;
}
.btn-outline::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(135deg, #ff4d00, #ff6a00);
  opacity: 0;
  transform: scale(0.9);
  transition:
    opacity 0.3s ease,
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.btn-outline:hover,
.btn-outline:focus-visible {
  color: #fff;
  border-color: #ff4d00;
  transform: translateY(-1px);
  box-shadow: 0 8px 24px -8px rgba(255, 77, 0, 0.65);
}
.btn-outline:hover::before,
.btn-outline:focus-visible::before {
  opacity: 1;
  transform: scale(1);
}

/* Focus */
:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
  border-radius: 2px;
}

/* Grain overlay — filmic presence, compositor-cheap */
.grain::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 60;
  pointer-events: none;
  opacity: 0.07;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* Editorial display scale — fluid, non-round, deliberately uneven steps.
   Display-1 is the hero voice: enormous on desktop, controlled on mobile.
   Majestic pass: taller ceiling, tighter tracking, heavier optical presence. */
.display-1 {
  font-size: clamp(3.5rem, 12vw, 13rem);
  line-height: 0.88;
  letter-spacing: -0.03em;
}
/* Monumental hero variant — max weight + optical sizing for coronation moments.
   Sized so the longest hero line ("Built with intent." + indent) fits the
   wrap in one line: ~10.4em at 8.75vw fits max 1344px container. */
.display-majestic {
  font-size: clamp(2.75rem, 8.75vw, 9.5rem);
  line-height: 0.92;
  letter-spacing: -0.03em;
  font-variation-settings: "opsz" 144, "wght" 500;
}
.display-2 {
  font-size: clamp(2.5rem, 6vw, 6rem);
  line-height: 0.94;
  letter-spacing: -0.022em;
}
/* Project titles + case-study moments: spatial, oversized, below chapters. */
.display-3 {
  font-size: clamp(1.875rem, 4.25vw, 3.5rem);
  line-height: 1;
  letter-spacing: -0.015em;
}
.lede {
  font-family: var(--font-sans);
  font-weight: 400;
  font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
  line-height: 1.65;
  color: var(--color-fog);
}

/* Sovereign vignette — deep ceremonial depth, pointer-events safe. */
.sovereign-vignette {
  background:
    radial-gradient(ellipse 80% 65% at 50% 30%, transparent 35%, rgba(10, 10, 11, 0.82) 100%),
    radial-gradient(ellipse 50% 35% at 50% 100%, rgba(255, 77, 0, 0.08), transparent 70%);
}

/* Tabular numerals for processional indices. */
.tnum {
  font-variant-numeric: tabular-nums lining-nums;
}

/* Project visual frame */
.frame {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--color-line);
  background: var(--color-coal);
}
.frame-majestic {
  box-shadow:
    inset 0 0 0 1px rgba(244, 242, 237, 0.04),
    0 24px 64px -32px rgba(0, 0, 0, 0.9);
}
a.frame-majestic:hover {
  box-shadow:
    inset 0 0 0 1px rgba(255, 77, 0, 0.25),
    0 24px 64px -24px rgba(255, 77, 0, 0.35);
}
.frame img, .frame .gen {
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}
a.frame:hover img, a.frame:hover .gen {
  transform: scale(1.03);
}

/* Shine sweep on project frames */
.shine {
  position: relative;
}
.shine::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(105deg, transparent 40%, rgba(244, 242, 237, 0.14) 50%, transparent 60%);
  transform: translateX(-120%);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}
a.shine:hover::after {
  transform: translateX(120%);
}

/* Marquee */
.marquee-track {
  display: inline-flex;
  align-items: baseline;
  gap: 0;
  will-change: transform;
}

/* CSS-driven marquee loop — always on, compositor-threaded */
@keyframes veyra-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.marquee-run {
  will-change: transform;
  animation-name: veyra-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

/* 404 flicker */
@keyframes veyra-flicker {
  0%, 100% { opacity: 1; }
  3% { opacity: 0.4; }
  6% { opacity: 1; }
  52% { opacity: 1; }
  54% { opacity: 0.5; }
  56% { opacity: 1; }
}
.flicker {
  animation: veyra-flicker 5s infinite;
}

/* Slow spin for orbital marks */
@keyframes veyra-spin {
  to { transform: rotate(360deg); }
}

/* Floating loop */
@keyframes veyra-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}
.float-slow {
  animation: veyra-float 7s ease-in-out infinite;
}

/* Hero perspective floor grid — scrolling toward viewer */
@keyframes veyra-grid-scroll {
  from { background-position-y: 0; }
  to { background-position-y: 72px; }
}
.floor-grid {
  background-image:
    linear-gradient(rgba(244, 242, 237, 0.22) 1px, transparent 1px),
    linear-gradient(90deg, rgba(244, 242, 237, 0.22) 1px, transparent 1px);
  background-size: 72px 72px;
  animation: veyra-grid-scroll 2.6s linear infinite;
}

/* Hero scanline sweep */
@keyframes veyra-scan {
  0% { top: -2%; opacity: 0; }
  8% { opacity: 1; }
  92% { opacity: 1; }
  100% { top: 102%; opacity: 0; }
}
.scanline {
  animation: veyra-scan 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* Inputs */
.field {
  width: 100%;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--color-line);
  padding: 0.85rem 0;
  color: var(--color-paper);
  font-size: 1rem;
}
.field::placeholder { color: var(--color-dim); }
.field:focus {
  outline: none;
  border-bottom-color: var(--color-accent);
}

/* Studio decision: motion is forced on for all visitors (see MotionConfig
   reducedMotion="never" in layout.tsx). No prefers-reduced-motion kill-switch. */

/* Serif italic accent — editorial contrast inside grotesk headlines.
   One italic word per headline, never a full sentence. */
.serif-accent {
  font-family: var(--font-serif-accent), Georgia, serif;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -0.01em;
}

/* Glass pills — frosted frosted controls over media (Kota nav language) */
.glass-pill {
  background: rgba(244, 242, 237, 0.12);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
  border: 1px solid rgba(244, 242, 237, 0.22);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 8px 32px -12px rgba(0, 0, 0, 0.6);
}
.glass-dark {
  background: rgba(10, 10, 11, 0.55);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  border: 1px solid rgba(244, 242, 237, 0.16);
}

/* Kota hybrid: outlined display text for marquee/hero contrast */
.text-outline {
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(244, 242, 237, 0.55);
}
.bg-\[\#F4F2ED\] .text-outline {
  -webkit-text-stroke-color: rgba(10, 10, 11, 0.5);
}

/* Rolling text link (RollLink primitive) */
.roll-link {
  height: 1lh;
  line-height: 1lh;
}
.roll-link-inner {
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
a:hover .roll-link-inner,
button:hover .roll-link-inner {
  transform: translateY(-50%);
}
.roll-link-inner > span {
  display: block;
  height: 1lh;
  line-height: 1lh;
}

/* Hide scrollbars on draggable rails (testimonials) */
.no-scrollbar {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* Headline media chip — slow liquid drift inside the pill */
@keyframes veyra-chip-drift {
  0% { background-position: 0% 40%; }
  50% { background-position: 100% 60%; }
  100% { background-position: 0% 40%; }
}
.chip-drift {
  background: linear-gradient(120deg, #FF4D00, #7a2bff, #00c2ff, #FF4D00);
  background-size: 300% 300%;
  animation: veyra-chip-drift 7s ease-in-out infinite;
}

/* Bouncy spring entrance for playful cards */
@keyframes veyra-pop {
  0% { transform: scale(0.94) translateY(24px); opacity: 0; }
  60% { transform: scale(1.02) translateY(-4px); opacity: 1; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}
.pop-in {
  animation: veyra-pop 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}
