# Template for local and platform environments.
# Real values live in .env.local / .env.production (git-ignored).
# Vercel/Netlify: set the same keys in the project dashboard (Production env).

# --- Contact form (src/app/api/contact/route.ts) ---
# Resend API key — https://resend.com/api-keys (server-side only)
RESEND_API_KEY=

# Inbox that receives inquiries
CONTACT_TO=

# Verified sender identity. Use "Veyra Inquiry <onboarding@resend.dev>" until a
# domain is verified in Resend, then switch to inquiries@yourdomain.
CONTACT_FROM="Veyra Inquiry <onboarding@resend.dev>"

# --- SEO (src/app/layout.tsx) ---
# Google Search Console verification token (HTML tag method). Optional — the
# meta tag is only emitted at build time when this is set.
GOOGLE_SITE_VERIFICATION=
